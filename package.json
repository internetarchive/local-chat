{
  "name": "@internetarchive/local-chat",
  "version": "0.2.0",
  "description": "A floating, resizable chat widget powered entirely by Chrome's on-device AI, grounded in context you provide.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Sawood Alam <sawood@archive.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/internetarchive/local-chat.git"
  },
  "homepage": "https://internetarchive.github.io/local-chat/",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "web-component",
    "custom-element",
    "chat",
    "on-device-ai",
    "chrome-ai"
  ],
  "main": "./dist/local-chat.js",
  "module": "./dist/local-chat.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/local-chat.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --project tsconfig.build.json",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "streaming-markdown": "^0.2.15"
  }
}
